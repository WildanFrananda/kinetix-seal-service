# Every setting is required and has no default: each process refuses to start without one of its own.
# Lab values are shown; the secrets come from the SOPS store and stay blank here.
# Two processes run from this image (SEAL-D17): the service (node dist/src/main.js) and the sponsor
# (node dist/src/sponsor_main.js). Each reads only its own settings; the service never holds the sponsor's seed.

# ── Both ──────────────────────────────────────────────────────────────────────────────────────────────
KINETIX_SEAL_SERVICE_VERSION=lab
KINETIX_SEAL_LOG_LEVEL=info
KINETIX_SEAL_DATABASE_URL=postgresql://kinetix_seal_app:<password>@kinetix-seal-db:5432/kinetix_seal_dev
KINETIX_SEAL_NETWORK_ID=preprod
KINETIX_SEAL_INDEXER_HTTP_URL=https://midnight-preprod.blockfrost.io/api/v0
KINETIX_SEAL_INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws
KINETIX_SEAL_PROOF_SERVER_URL=http://kinetix-seal-proof-server:6300
KINETIX_SEAL_BLOCKFROST_PROJECT_ID=
KINETIX_SEAL_SHUTDOWN_GRACE_SECONDS=25
# The mesh: seal's leaf is mounted at KINETIX_PKI_DIR (tls.crt, tls.key, ca.pem).
KINETIX_PKI_DIR=/pki
KINETIX_TRUST_DOMAIN=kinetix.local

# ── The service ───────────────────────────────────────────────────────────────────────────────────────
KINETIX_SEAL_HTTP_PORT=8012
# 32 bytes of lowercase hex: it signs for every registry generation.
KINETIX_SEAL_ISSUER_SECRET=
# The sponsor's spending API, over mutual TLS with seal's own leaf.
KINETIX_SEAL_SPONSOR_URL=https://kinetix-seal-sponsor:8014
KINETIX_SEAL_SPONSOR_POLL_SECONDS=15
KINETIX_SEAL_SPONSOR_TIMEOUT_SECONDS=10
# The courier facts: matching's deliveries and review's driver reviews. Matching serves at most 500 a page.
KINETIX_SEAL_MATCHING_GRPC_ADDR=kinetix-matching-service:50053
KINETIX_SEAL_REVIEW_GRPC_ADDR=kinetix-review-grpc:50060
KINETIX_SEAL_FACTS_TICK_SECONDS=60
KINETIX_SEAL_FEED_TIMEOUT_SECONDS=30
KINETIX_SEAL_FEED_PAGE_SIZE=500
KINETIX_SEAL_FEED_PAGES_PER_TICK=20
KINETIX_SEAL_REGISTRY_CHECK_SECONDS=600
KINETIX_SEAL_MIDNIGHT_STEP_SECONDS=300

# ── The sponsor ───────────────────────────────────────────────────────────────────────────────────────
# The sponsor serves /health, /health/ready and /metrics on KINETIX_SEAL_HTTP_PORT (8013 there), and the
# spending API on KINETIX_SEAL_SPONSOR_API_PORT.
KINETIX_SEAL_SPONSOR_API_PORT=8014
KINETIX_SEAL_NODE_WS_URL=wss://rpc.midnight-preprod.blockfrost.io
KINETIX_SEAL_SPONSOR_MNEMONIC=
KINETIX_SEAL_WALLET_STATE_DIR=/var/lib/seal/wallet
KINETIX_SEAL_SPONSOR_MONITOR_SECONDS=30
KINETIX_SEAL_WALLET_CHECKPOINT_SECONDS=600
KINETIX_SEAL_SPONSOR_MIN_DUST_COINS=3
KINETIX_SEAL_SPONSOR_MIN_DUST=100
# Only for split_night.js.
KINETIX_SEAL_SPLIT_OUTPUTS=10
