#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

if [ "${1:-}" = "down" ]; then
  exec docker compose -f toolchain/compose.yaml down --volumes
fi

if [ -t 0 ] && [ -t 1 ]; then
  exec docker compose -f toolchain/compose.yaml run --build --rm toolchain "$@"
fi

exec docker compose -f toolchain/compose.yaml run --build --rm -T toolchain "$@"
