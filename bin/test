#!/bin/sh
set -eu

: "${KINETIX_SEAL_TEST_DATABASE_URL:?bin/test runs the database tests too: run it as bin/dev bin/test}"

cd "$(dirname "$0")/.."

sh bin/test-pki

node --test --test-reporter=spec --test-concurrency=1 "dist/tests/database/**/*.test.js"
node --test --test-reporter=spec --experimental-test-coverage $(find dist/tests -name '*.test.js' -not -path 'dist/tests/database/*' | sort)
