// SPDX-License-Identifier: MIT
pragma language_version >= 0.23.0;

import CompactStandardLibrary;
import "@openzeppelin/compact-contracts/security/Pausable" prefix Pausable_;
import "ApprovedPredicates";
import "Credential";
import "Holder";
import "IssuedCredentials";
import "IssuerAuthority";
import "Predicate";
import "Presentations";

constructor(initialIssuerPk: Bytes<32>) {
  initializeIssuer(initialIssuerPk);
}

circuit issue(leaf: Bytes<32>): [] {
  assertIssuer();
  Pausable_assertNotPaused();
  _issue(leaf);
}

circuit revoke(index: Uint<64>): [] {
  assertIssuer();
  _revoke(index);
}

circuit approvePredicate(predicate: Predicate): [] {
  assertIssuer();
  Pausable_assertNotPaused();
  _approvePredicate(predicate);
}

circuit withdrawPredicate(id: Bytes<32>): [] {
  assertIssuer();
  _withdrawPredicate(id);
}

circuit pause(): [] {
  assertIssuer();
  Pausable__pause();
}

circuit unpause(): [] {
  assertIssuer();
  Pausable__unpause();
}

circuit present(challenge: Bytes<32>, id: Bytes<32>): [] {
  Pausable_assertNotPaused();
  assertUnanswered(challenge);

  const predicate = approvedPredicate(id);
  const credential = heldCredential();
  const leaf = credentialLeaf(credential, holderPublicKey(holderSecret()));
  const path = credentialPath(leaf);

  assert(path.leaf == leaf, "the path does not lead to the credential");
  assertIssued(path);
  assert(credential.classId == predicate.classId, "the credential is of another class");

  for (const i of 0..4) {
    assert(credential.attributes[i] >= predicate.minimums[i], "the credential does not meet the predicate");
  }

  _recordPresentation(challenge, id);
}

export {
  Credential,
  Predicate,
  issuerPk,
  proposedIssuerPk,
  issued,
  predicates,
  presentations,
  Pausable__isPaused,
  issuerPublicKey,
  holderPublicKey,
  credentialLeaf,
  predicateId,
  issue,
  revoke,
  approvePredicate,
  withdrawPredicate,
  proposeIssuer,
  acceptIssuer,
  pause,
  unpause,
  present
};
