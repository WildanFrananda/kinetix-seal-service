pragma language_version >= 0.23.0;

module IssuedCredentials {
  import CompactStandardLibrary;

  ledger issued: HistoricMerkleTree<20, Bytes<32>>;

  circuit _issue(leaf: Bytes<32>): [] {
    issued.insertHash(disclose(leaf));
  }

  circuit _revoke(index: Uint<64>): [] {
    issued.insertIndexDefault(disclose(index));
    issued.resetHistory();
  }

  circuit assertIssued(path: MerkleTreePath<20, Bytes<32>>): [] {
    assert(issued.checkRoot(disclose(merkleTreePathRootNoLeafHash<20>(path))), "the credential was not issued");
  }

  export {
    issued,
    _issue,
    _revoke,
    assertIssued
  };
}
