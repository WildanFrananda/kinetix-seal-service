pragma language_version >= 0.23.0;

module Reporter {
  import CompactStandardLibrary;
  import "RightLeaf";

  witness reporterSecret(): Bytes<32>;
  witness heldOrder(): Bytes<32>;
  witness rightPath(leaf: Bytes<32>): MerkleTreePath<20, Bytes<32>>;

  pure circuit reporterKey(secret: Bytes<32>): Field {
    return transientHash<Vector<2, Bytes<32>>>([pad(32, "kinetix:seal:reporter"), secret]);
  }

  pure circuit rightLeaf(merchant: Bytes<32>, window: Uint<32>, order: Bytes<32>, reporter: Field): Bytes<32> {
    return upgradeFromTransient(
      transientHash<RightLeaf>(RightLeaf {
        domain: pad(32, "kinetix:seal:report"),
        merchant: merchant,
        window: window,
        order: order,
        reporter: reporter
      })
    );
  }

  pure circuit reportNullifier(secret: Bytes<32>, order: Bytes<32>): Bytes<32> {
    return upgradeFromTransient(
      transientHash<Vector<3, Bytes<32>>>([pad(32, "kinetix:seal:report:nullifier"), secret, order])
    );
  }

  export {
    reporterSecret,
    heldOrder,
    rightPath,
    reporterKey,
    rightLeaf,
    reportNullifier
  };
}
