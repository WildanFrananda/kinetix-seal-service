generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/postgres/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model SponsorEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  condition   String   @db.VarChar(16)
  dustBalance Decimal  @map("dust_balance") @db.Decimal(39, 0)
  dustCoins   Int      @map("dust_coins")
  nightUtxos  Int      @map("night_utxos")

  @@index([occurredAt])
  @@map("sponsor_events")
}

model RegistryGeneration {
  generation      Int       @id
  contractAddress String    @unique @map("contract_address") @db.VarChar(128)
  networkId       String    @map("network_id") @db.VarChar(32)
  buildDigest     String    @map("build_digest") @db.Char(64)
  status          String    @db.VarChar(16)
  deployTxId      String?   @map("deploy_tx_id") @db.VarChar(160)
  anchorHeight    BigInt?   @map("anchor_height")
  anchorHash      String?   @map("anchor_hash") @db.Char(64)
  retiredReason   String?   @map("retired_reason") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  retiredAt       DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([status])
  @@map("registry_generations")
}

model FeedCursor {
  stream             String    @id @db.VarChar(16)
  throughTransaction BigInt    @map("through_transaction")
  throughSequence    BigInt    @map("through_sequence")
  caughtUpAt         DateTime? @map("caught_up_at") @db.Timestamptz(6)

  @@map("feed_cursors")
}

model CourierDelivery {
  orderNumber       String   @id @map("order_number") @db.VarChar(128)
  driverPrincipalId String   @map("driver_principal_id") @db.VarChar(128)
  deliveredAt       DateTime @map("delivered_at") @db.Timestamptz(6)

  @@index([driverPrincipalId])
  @@map("courier_deliveries")
}

model DriverReview {
  reviewId          String   @id @map("review_id") @db.VarChar(128)
  driverPrincipalId String   @map("driver_principal_id") @db.VarChar(128)
  rating            Int      @db.SmallInt
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)

  @@index([driverPrincipalId])
  @@map("driver_reviews")
}

model Credential {
  id              String               @id @db.Uuid
  principalId     String               @map("principal_id") @db.VarChar(128)
  classId         String               @map("class_id") @db.Char(64)
  attributes      BigInt[]
  salt            String               @db.Char(64)
  holderPublicKey String               @map("holder_public_key") @db.VarChar(80)
  issueDay        Int                  @map("issue_day")
  requestedAt     DateTime             @map("requested_at") @db.Timestamptz(6)
  issuances       CredentialIssuance[]

  @@unique([principalId, classId, issueDay])
  @@index([principalId, classId, requestedAt])
  @@map("credentials")
}

model CredentialIssuance {
  credentialId String     @map("credential_id") @db.Uuid
  generation   Int
  status       String     @db.VarChar(16)
  leaf         String?    @db.Char(64)
  leafIndex    BigInt?    @map("leaf_index")
  txId         String?    @map("tx_id") @db.VarChar(160)
  attempts     Int
  queuedAt     DateTime   @map("queued_at") @db.Timestamptz(6)
  submittedAt  DateTime?  @map("submitted_at") @db.Timestamptz(6)
  issuedAt     DateTime?  @map("issued_at") @db.Timestamptz(6)
  credential   Credential @relation(fields: [credentialId], references: [id])

  @@id([credentialId, generation])
  @@index([generation, status, queuedAt])
  @@map("credential_issuances")
}
